#
# 작성자: 최유준
# 작성 날짜: 2026-09-04 (v2 - PR #48 팀 확정 스펙 반영, 2026-09-04 재작성)
#
# [확정 스펙 출처] 팀원 메시지(PR #48 적용 값, 2026-09-04)
# - Base Image: python:3.13.15-slim-trixie
# - uv: 0.12.5
# - 실행 명령: uvicorn seokpan.app:app --app-dir src --host 0.0.0.0 --port 8000
# - Container Port: 8000
# - HEALTHCHECK: /health/live
# - UID/GID: 10001
# - Runtime Image 포함 대상: /app/src, /app/.venv, /app/alembic.ini, /app/migrations
#   (migrations/audit/도 제외하지 않음)
# - Migration은 Image에 실행 자산만 포함, 기본 CMD에서는 실행하지 않음
# - Base Image는 Tag가 아닌 실제 Digest로 고정 (latest/Major·Minor 이동 Tag 금지)
#
# [Digest 확보 방법] cicd 네임스페이스에서 kubectl run으로 개별 Pull 후
# .status.containerStatuses[0].imageID 확인 (2026-09-04)
#   python:3.13.15-slim-trixie  -> sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
#   ghcr.io/astral-sh/uv:0.12.5 -> sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1
#
# [PR #48 범위 밖] /metrics 구현, DB·Redis 실제 연결, Alembic 자동 실행,
# Image 내 Credential/Private Key 포함, 임의 Replica/Resource 결정 — 전부 미포함.
#
# Rootless BuildKit(buildctl-daemonless.sh)으로 빌드되는 것을 전제로 하며,
# Host Docker Socket을 사용하지 않는다(04 문서 11.1절 원칙).

# ---------- Stage 1: builder ----------
FROM python:3.13.15-slim-trixie@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS builder

COPY --from=ghcr.io/astral-sh/uv@sha256:e85be844203885286c60ffad8a858d48afb6c5a5c237ca0e67f12e74b8f174b1 /uv /uvx /usr/local/bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# 의존성만 먼저 설치해 레이어 캐시 극대화 (소스 변경 시 재설치 방지)
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

# 실제 소스·Alembic 자산 복사 후 프로젝트 자체 설치
# (migrations/audit/ 포함 — 팀 확정 스펙에 따라 제외하지 않음)
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

# ---------- Stage 2: runtime ----------
FROM python:3.13.15-slim-trixie@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285 AS runtime

# Rootless 원칙: non-root 사용자로 실행 (UID/GID 10001 고정)
RUN groupadd --gid 10001 seokpan && \
    useradd --uid 10001 --gid seokpan --shell /usr/sbin/nologin --create-home seokpan

WORKDIR /app

COPY --from=builder --chown=seokpan:seokpan /app/.venv /app/.venv
COPY --from=builder --chown=seokpan:seokpan /app/src /app/src
COPY --from=builder --chown=seokpan:seokpan /app/alembic.ini /app/alembic.ini
COPY --from=builder --chown=seokpan:seokpan /app/migrations /app/migrations

ENV PATH="/app/.venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1

USER seokpan

EXPOSE 8000

# curl 미설치(slim 이미지) 전제 — Python 표준 라이브러리로 헬스체크
# 경로는 /health/live (health.py 실제 라우트, 팀 확정 스펙과 일치)
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live')" || exit 1

# 기본 CMD는 애플리케이션 서버만 기동 — Migration(seokpan-migration-gate)은
# 여기 포함하지 않음. Image에는 실행 자산(alembic.ini, migrations/)만 포함되어
# 필요 시 별도로 `seokpan-migration-gate` 명령을 명시적으로 실행해야 함.
CMD ["uvicorn", "seokpan.app:app", "--app-dir", "src", "--host", "0.0.0.0", "--port", "8000"]
#
# 작성자: 최유준
# 작성 날짜: 2026-09-04 (v2 - PR #48 팀 확정 스펙 반영, 2026-09-04 재작성)
#
# [정정 2026-09-04, 실제 검증 중 발견] 최상단 `# syntax=docker/dockerfile:1` pragma
# 제거함. backend/Dockerfile과 동일 원인(외부 frontend nested 실행 실패) —
# 상세 근거는 backend/Dockerfile 주석 참고.
#
# [확정 스펙 출처] 팀원 메시지(PR #48 적용 값, 2026-09-04)
# - Build: Node.js 24.19.0, npm 12.0.2, npm ci && npm run build
# - Runtime Image: nginxinc/nginx-unprivileged:1.30.4-alpine3.24
# - Container Port: 8080
# - Health Endpoint: /health/live
# - SPA Fallback: try_files $uri $uri/ /index.html
# - Nginx PID·임시 파일 경로: /tmp 사용
# - readOnlyRootFilesystem 조건에서 실행 가능해야 함
# - /assets 장기 Cache + immutable, index.html은 재검증 Cache
# - Base Image는 Tag가 아닌 실제 Digest로 고정
#
# [Digest 확보] cicd 네임스페이스 kubectl run 개별 Pull 후 imageID 확인 (2026-09-04)
#   node:24.19.0-alpine                          -> sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43
#   nginxinc/nginx-unprivileged:1.30.4-alpine3.24 -> sha256:9b87ad3dd9f431c733f19dfb278c7eb3dba9dca381942c79818bb42f1a566a83
#
# [정정] v1의 nginx:1.27-alpine + sed로 포트/권한 수동 조정하던 방식은 폐기.
# nginx-unprivileged 이미지는 처음부터 non-root(uid 101)·8080 포트로 설계되어
# 별도 sed 트릭이 불필요해짐.

# ---------- Stage 1: build ----------
FROM node:24.19.0-alpine@sha256:d32cdf619f63fe0471182d08996dd516c6275bb5fd31ae06e55a570bd9e1ad43 AS builder

WORKDIR /app

# [정정 2026-09-04, 리뷰 반영] corepack enable(인자 없음)은 npm을 shim 대상에서
# 기본 제외한다 — npm은 Node.js에 이미 번들되어 있어, corepack 공식 문서가
# "npm shim은 명시적으로 요청하지 않으면 설치되지 않는다"고 명시함. 그 결과
# corepack prepare npm@12.0.2 --activate가 버전을 준비만 하고 실제 `npm` 커맨드는
# Node 24 이미지에 번들된 기본 npm(11.17.0)을 그대로 참조 — npm ci 시점
# EBADENGINE 경고로 발견됨. `corepack enable npm`으로 npm을 명시적으로 shim
# 대상에 포함시키고, npm --version 검증을 빌드 타임에 강제해 재발 방지.
RUN corepack enable npm && \
    corepack prepare npm@12.0.2 --activate && \
    npm --version | grep -qx '12.0.2' || (echo "ERROR: npm version mismatch, expected 12.0.2" && exit 1)

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---------- Stage 2: runtime (nginx-unprivileged) ----------
FROM nginxinc/nginx-unprivileged:1.30.4-alpine3.24@sha256:9b87ad3dd9f431c733f19dfb278c7eb3dba9dca381942c79818bb42f1a566a83 AS runtime

# nginx-unprivileged 이미지는 이미 non-root(uid 101, nginx 사용자)로 기본 구성됨.
# readOnlyRootFilesystem 대응: PID·caches·temp 전부 /tmp 하위로 재배치
# (컨테이너 파일시스템이 read-only여도 /tmp만 emptyDir로 쓰기 가능하면 기동됨 —
# 실제 Pod의 volumeMounts에 /tmp를 emptyDir로 마운트하는 건 GitOps Deployment 쪽 책임)
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

# curl 없을 수 있는 경량 이미지 전제 — wget은 alpine 계열에 기본 포함(BusyBox)
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:8080/health/live || exit 1

CMD ["nginx", "-g", "daemon off;"]

