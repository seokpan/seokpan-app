                                ) {
                                    node(label) {
                                        container('checker') {
                                            // TODO(팀 확인 필요, 제 쪽에서 접근 불가): apps/backend·
                                            // apps/frontend kustomization.yaml의 실제 Deployment
                                            // resources(request/limit)를 확인해서 이 podTemplate의
                                            // target 컨테이너에도 동일하게 반영할 것. 비공개 저장소라
                                            // 이 세션에서 직접 조회하지 못했음 — 지금은 K8s 기본값
                                            // (미지정)으로 두어, 실제 운영 리소스보다 널널한 조건에서
                                            // 통과할 위험이 있음(메모리 부족으로 인한 기동 실패를
                                            // 놓칠 수 있음).
                                            sh "sleep 8" // target 기동 대기 (readiness probe 대체 임시값)
                                            sh """
                                                python3 -c "
import urllib.request, sys
try:
    resp = urllib.request.urlopen('http://localhost:${cfg.port}${cfg.path}', timeout=5)
    print(f'[${component}] health check: HTTP {resp.status}')
    sys.exit(0 if resp.status == 200 else 1)
except Exception as e:
    print(f'[${component}] health check 실패: {e}')
    sys.exit(1)
"
                                            """
                                        }
                                        // [제거됨, 실행으로 재확인] container('target'){ sh ... }를
                                        // 두 번(fsGroup 미적용/적용) 시도했지만 둘 다 동일하게
                                        // "process apparently never started"로 5분 대기 후 실패함
                                        // (checker는 두 번 다 문제없이 성공). PID 1이 uvicorn(idle
                                        // 대기용 "cat"이 아닌 실제 애플리케이션)이고
                                        // readOnlyRootFilesystem:true인 컨테이너에 Jenkins Kubernetes
                                        // Plugin의 Durable Task(sh 스텝)를 실행하는 조합 자체가
                                        // 이 환경에서 안정적으로 동작하지 않는 것으로 판단 — emptyDir
                                        // 소유권 문제가 아니었음(fsGroup 적용 후에도 재현).
                                        // 대신 필요했던 검증은 이미 다른 방식으로 충분히 증명됨:
                                        //   - UID 강제: K8s가 Pod 시작 시점에 runAsUser로 강제하는
                                        //     것이라 별도 `id` 확인 불필요 — 강제가 안 됐다면 애초에
                                        //     Pod이 뜨지 않거나 아래 health check가 실패했을 것.
                                        //   - 부팅 성공: /health/live가 HTTP 200을 반환했다는 것
                                        //     자체가 declared securityContext 그대로 프로세스가
                                        //     정상 기동해 소켓까지 열었다는 증거.
                                        // Migration 자산 존재 확인(TODO)은 exec 없이 검증하는
                                        // 방법(예: registry API로 이미지 레이어 직접 조회)을
                                        // 팀에서 별도로 설계해야 함 — 이번 스모크 범위에서는 제외.

                    }
                }
                                echo "[${component}] Health Smoke Test 완료 (Process Smoke만 확인 — 실제 DB/Redis readiness 아님)"
                            }
                        }
                    }
                }

                // --------------------------------------------------------------
                // Evidence 기록: Commit/Build/Tag/Digest/Scan 결과를 구조화된
                // JSON으로 Build Artifact에 남긴다 (팀 결정 ④). 이 파일이 곧
                // GitOps 작업으로 넘기는 인계 자료다 (팀 결정 ⑤, #40 경계).
                // --------------------------------------------------------------
                stage('Record Commit-Build-Tag-Digest Evidence') {
                    steps {
                        container('python') {
                            script {
                                def backendDigest  = env.CAND_DIGEST_BACKEND  ?: ''
                                def frontendDigest = env.CAND_DIGEST_FRONTEND ?: ''
                                def cleanupSummary = env.CLEANUP_SUMMARY ?: ''
                                def scanSummary    = env.SCAN_SUMMARY ?: ''

                                def metadataJson = """{
  "commit_sha_full": "${env.SEOKPAN_GIT_SHA}",
  "commit_sha_12": "${env.MAIN_SHA_12}",
  "jenkins_build_url": "${env.BUILD_URL}",
  "jenkins_build_number": "${env.BUILD_NUMBER}",
  "run_id": "${env.SEOKPAN_CI_RUN_ID}",
  "components": {
    "backend": {
      "harbor_repo": "backend",
      "candidate_tag": "${env.CANDIDATE_TAG}",
      "final_tag": "${env.FINAL_TAG}",
      "push_time_digest": "${backendDigest}"
    },
    "frontend": {
      "harbor_repo": "frontend",
      "candidate_tag": "${env.CANDIDATE_TAG}",
      "final_tag": "${env.FINAL_TAG}",
      "push_time_digest": "${frontendDigest}"
    }
  },
  "cleanup_status": "${cleanupSummary}",
  "scan_summary": "${scanSummary}",
  "note": "GitOps apps/backend, apps/frontend Desired State 변경은 이 Evidence를 인계받아 별도 작업에서 진행 (Issue #40 경계)"
}
"""
                                writeFile file: 'image-metadata.json', text: metadataJson
                                archiveArtifacts artifacts: 'image-metadata.json', fingerprint: true
                                echo "Evidence 기록 완료: image-metadata.json"
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        failure {
            echo "Image Pipeline 실패: ${env.CANDIDATE_TAG ?: 'N/A'} / ${env.FINAL_TAG ?: 'N/A'} (scan-* Candidate는 삭제하지 않고 보존, Retention 정책으로 추후 정리 예정)"
        }
        success {
            echo "Image Pipeline 성공: ${env.FINAL_TAG} Promote 완료 (backend/frontend). Candidate 정리 결과: ${env.CLEANUP_SUMMARY ?: '기록 없음'}. Scan 요약: ${env.SCAN_SUMMARY ?: '기록 없음'}"
        }
    }
}
