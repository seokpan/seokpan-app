// ============================================================================
// seokpan-app :: Image Pipeline (main branch)
// 목적: main push 시 P1 재검증 -> Backend/Frontend Build -> SBOM/Scan -> Harbor
//       Push -> Tag Promote 전체 흐름 (Issue #58 P2)
// 관련 Issue: #58 (main 브랜치 Image Pipeline)
// 담당: 최유준 (Delivery & Observability)
// 작성 날짜: 2026-09-10
// 수정 날짜: 2026-09-10 (2차, 팀 리뷰 반영)
//   - [수정] Cleanup이 Artifact 전체를 지우던 버그 수정. Promote 이후 Candidate와
//     Final Tag는 같은 digest(같은 Artifact)를 가리키므로, 기존
//     DELETE /artifacts/{cand} 는 방금 만든 최종 git-* Tag의 Artifact까지 지울
//     수 있었음. Tag 전용 삭제 엔드포인트(/artifacts/{ref}/tags/{tag_name})로 교체.
//   - [수정] SBOM/Scan 스테이지를 echo(비차단) -> error(fail-closed)로 전환.
//     미구현 상태에서 Promote까지 도달해 미검증 이미지가 Immutable로 고정되는
//     사고를 구조적으로 차단.
//   - [수정] 저장소 루트 단일 이미지 빌드 -> Backend/Frontend 분리 빌드로 재설계
//     (Issue #58 원문 기준 backend/, frontend/ 두 Dockerfile 계약 반영).
//     Harbor repository 이름은 seokpan-app-backend / seokpan-app-frontend로
//     가정 — Issue #47/PR #48 기준과 다르면 확인 필요.
//   - [보류] P1 재검증(Lint/Test/npm audit 재실행) 스테이지는 이번 수정 범위
//     밖이라 fail-closed placeholder로만 추가. Health Smoke Test는 Issue #58
//     본문에 "실행 방법 미설계"로 명시되어 있어 비차단 TODO로 유지.
//     Commit-Build-Tag-Digest 연결 기록도 이번 범위 밖, TODO만 남김.
// 수정 날짜: 2026-09-10 (3차) — Scan Stage 실제 구현.
//   Harbor 내장 Trivy 스캐너를 API로 트리거(POST .../scan) -> 완료 폴링
//   (GET ...?with_scan_overview=true) -> 정규화 리포트 조회
//   (GET .../additions/vulnerabilities) -> CRITICAL 전부 실패 /
//   HIGH+fix_version 존재 시 실패 정책을 코드로 그대로 구현.
//   [전제, 확인 필요] seokpan 프로젝트에 Trivy 스캐너가 실제로 등록되어
//   있는지 아직 미확인 — 미등록 시 스캔 트리거 또는 폴링 타임아웃 단계에서
//   fail-closed로 걸림 (조용히 통과되지는 않음).
//
// 수정 날짜: 2026-09-10 (4차) — Scan Stage를 Harbor 내장 스캐너 API 방식에서
//   Trivy CLI 직접 실행 방식으로 전환. Harbor에 Trivy Adapter가 등록되어
//   있지 않음을 확인(docker ps에 컨테이너 자체가 없음) → 공유 인프라인
//   Harbor 스택 변경 대신, Issue #58 원문이 명시한 "별도 Scanner로 원격
//   스캔" 방식 채택. ci-python 이미지(cicd/ci-images/python/Dockerfile)에
//   Trivy 바이너리 COPY 추가, 인증은 기존 harbor-robot-account Credential
//   재사용, CA는 buildkit과 동일하게 SSL_CERT_FILE로 지정.
//   [확인 필요] Trivy DB 다운로드용 외부 egress 허용 여부, ci-python 새
//   digest 확정 후 JCasC python 컨테이너 image 반영 여부.
//
// 주의:
//   - 이 파일은 App #62의 PR 검사용 Jenkinsfile과 별개다.
//     App #62 -> buildkit-rootless-pr (Credential 없음, Push 불가)
//     본 파일 -> buildkit-rootless   (Credential 있음, Push 가능)
//   - Guard Stage 200(최종 태그 이미 존재) 케이스는 "실패 처리"로 확정됨
//     (중복 실행 방지). 200/404 외 모든 응답(401/403/5xx/Timeout/DNS/TLS/파싱
//     실패 포함)도 조회 실패로 간주해 fail-closed 처리.
//   - 남은 TODO(팀 확인/설계 진행 중): P1 재검증 스테이지 실제 구현,
//     SBOM native attestation 실제 동작 검증, Health Smoke Test 실행 방식
//     설계, FAIL Candidate Retention 기간/개수, Commit-Build-Tag-Digest
//     연결 기록 방식, ci-python 이미지의 Trivy digest 확정 및 JCasC 반영,
//     Trivy DB 다운로드용 클러스터 egress 허용 여부 확인.
// ============================================================================

// Backend/Frontend 두 컴포넌트를 순회하며 Guard/Build/SBOM/Scan/Promote/Cleanup을
// 반복 적용하기 위한 목록. 순서 자체에 의미는 없음.
def COMPONENT_REPO = [
    backend : 'seokpan-app-backend',
    frontend: 'seokpan-app-frontend'
]

pipeline {
    agent {
        kubernetes {
            label 'buildkit-rootless'
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        HARBOR_HOST     = 'harbor.seokpan.soldesk.store'
        HARBOR_PROJECT  = 'seokpan'
        HARBOR_API_CRED = 'harbor-api-robot-account'   // robot$seokpan+seokpan-api (Jenkins Credential)
        // BuildKit push 인증(robot$seokpan+seokpan-ci)은 Jenkins Credential이 아니라
        // PodTemplate(harbor-robot-dockerconfig secretVolume)이 buildkit 컨테이너의
        // /home/user/.docker에 이미 직접 마운트해둠. withCredentials 불필요.
        HARBOR_CA_PATH  = '/etc/buildkit/certs/ca.crt' // harbor-ca-cert configMapVolume 실제 마운트 경로
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.MAIN_SHA_12   = sh(script: 'git rev-parse HEAD | cut -c1-12', returnStdout: true).trim()
                    env.CANDIDATE_TAG = "scan-${env.MAIN_SHA_12}-${env.BUILD_NUMBER}"
                    env.FINAL_TAG     = "git-${env.MAIN_SHA_12}"
                    echo "Candidate tag: ${env.CANDIDATE_TAG}"
                    echo "Final tag:     ${env.FINAL_TAG}"
                }
            }
        }

        // --------------------------------------------------------------
        // TODO(이번 수정 범위 밖, Issue #58 완료 기준의 블로킹 항목):
        // main의 보호된 Commit을 다시 Checkout하여 Backend/Frontend Lint & Test,
        // npm audit을 재실행해야 함. 실패 시 이후 Build로 진행되면 안 됨.
        // 아직 구현 전이므로 fail-closed로 막아 "미검증 상태로 통과"를
        // 방지한다 (echo가 아니라 error() 사용).
        // --------------------------------------------------------------
        stage('P1 Revalidation (미구현)') {
            steps {
                error("P1 재검증(Lint/Test/npm audit 재실행) 스테이지 미구현. Issue #58 완료 기준 항목이라 구현 전까지는 fail-closed로 중단합니다.")
            }
        }

        // --------------------------------------------------------------
        // Guard Stage: Backend/Frontend 각각 최종 태그 존재 여부 3-way 분기
        //   200 -> 실패 처리 (중복 실행 방지, 확정된 정책)
        //   404 -> 정상 진행
        //   그 외 -> fail-closed로 중단
        // 두 컴포넌트 중 하나라도 막히면 전체 파이프라인을 중단한다.
        // --------------------------------------------------------------
        stage('Guard: Final Tag Check') {
            steps {
                container('python') {
                    withCredentials([usernamePassword(
                        credentialsId: env.HARBOR_API_CRED,
                        usernameVariable: 'HARBOR_API_USER',
                        passwordVariable: 'HARBOR_API_PASS'
                    )]) {
                        script {
                            COMPONENT_REPO.each { component, repo ->
                                env.CURRENT_REPO = repo
                                def status = sh(
                                    script: '''
                                        python3 - <<'PYEOF'
import os, sys, urllib.request, urllib.error, base64

host  = os.environ["HARBOR_HOST"]
proj  = os.environ["HARBOR_PROJECT"]
repo  = os.environ["CURRENT_REPO"]
tag   = os.environ["FINAL_TAG"]
user  = os.environ["HARBOR_API_USER"]
pw    = os.environ["HARBOR_API_PASS"]

url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{tag}"
req = urllib.request.Request(url)
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
req.add_header("Authorization", f"Basic {auth}")

try:
    with urllib.request.urlopen(req, timeout=15, cafile=os.environ["HARBOR_CA_PATH"]) as resp:
        print(resp.status)
except urllib.error.HTTPError as e:
    print(e.code)
except Exception as e:
    print("ERR", file=sys.stderr)
    print(str(e), file=sys.stderr)
    print("-1")
PYEOF
                                    ''',
                                    returnStdout: true
                                ).trim()

                                echo "Guard Stage [${component}/${repo}] HTTP status: ${status}"

                                if (status == '200') {
                                    error("Guard Stage: [${component}] 최종 태그 ${env.FINAL_TAG} 가 이미 존재합니다 (repo=${repo}). 중복 실행 방지를 위해 중단합니다.")
                                } else if (status == '404') {
                                    echo "Guard Stage [${component}]: 최종 태그 없음, 정상 진행합니다."
                                } else {
                                    error("Guard Stage: [${component}] 예상치 못한 응답(${status}). fail-closed 정책에 따라 중단합니다.")
                                }
                            }
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // Backend/Frontend 각각 별도 context/Dockerfile로 빌드 & Push.
        // Harbor repository는 컴포넌트별로 분리(seokpan-app-backend/-frontend).
        // --------------------------------------------------------------
        stage('Build & Push Candidate (Backend/Frontend)') {
            steps {
                container('buildkit') {
                    script {
                        COMPONENT_REPO.each { component, repo ->
                            sh """
                                buildctl-daemonless.sh build \\
                                  --frontend dockerfile.v0 \\
                                  --local context=./${component} \\
                                  --local dockerfile=./${component} \\
                                  --output type=image,name=${env.HARBOR_HOST}/${env.HARBOR_PROJECT}/${repo}:${env.CANDIDATE_TAG},push=true
                            """
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // 팀 확정 방침: BuildKit native SBOM/Provenance attestation을 이
        // rootless 환경에서 먼저 검증 후 채택 여부 결정. 아직 검증 전이므로
        // Promote 도달을 막기 위해 error()로 fail-closed 처리.
        // --------------------------------------------------------------
        stage('SBOM & Provenance (미검증)') {
            steps {
                container('buildkit') {
                    error("BuildKit native attestation 검증 전. 검증 완료 및 구현 전까지 fail-closed로 Promote 도달을 차단합니다.")
                    // 예시(검증 후 대체 예정):
                    // buildctl-daemonless.sh build ... --attest type=sbom --attest type=provenance,mode=max
                }
            }
        }

        // --------------------------------------------------------------
        // Scan: Harbor를 거치지 않고 Trivy CLI로 Candidate 이미지를 원격
        // 스캔한다 (Issue #58 원문: "Trivy/Grype 등 별도 Scanner로 Candidate
        // Tag를 원격 스캔"). Harbor 스캐너 등록/공유 인프라 변경이 전혀
        // 필요 없다 — Trivy 바이너리는 ci-python 이미지에 COPY로 포함됨
        // (Dockerfile.ci-python, digest는 팀에서 직접 pull하여 확정).
        //
        // 인증은 기존 harbor-robot-account(robot$seokpan+seokpan-ci,
        // pull 권한만 필요) Jenkins Credential을 그대로 재사용 — 새 Credential
        // 불필요. CA는 buildkit 컨테이너와 동일하게 Pod 레벨로 마운트된
        // harbor-ca-cert(/etc/buildkit/certs/ca.crt)를 SSL_CERT_FILE로
        // 지정해 Go 표준 라이브러리가 인식하게 한다.
        //
        // [확인 필요] Trivy가 취약점 DB(ghcr.io/aquasecurity/trivy-db)를
        // 내려받으려면 cicd 네임스페이스의 buildkit-rootless Pod이 외부
        // 인터넷 egress를 쓸 수 있어야 함. 막혀있으면 이 스테이지가 DB
        // 다운로드 단계에서 fail-closed로 걸린다(에러 메시지로 원인 구분 가능).
        //
        // 팀 확정 정책(임의 예외처리 없이 그대로 구현):
        //   - CRITICAL: fix 존재 여부 무관 무조건 실패
        //   - HIGH: FixedVersion이 존재하는(=고칠 수 있는) 항목이 하나라도
        //     있으면 실패
        //   - 위 조건에 해당하지 않으면 통과
        // --------------------------------------------------------------
        stage('Scan') {
            steps {
                container('python') {
                    withCredentials([usernamePassword(
                        credentialsId: 'harbor-robot-account',
                        usernameVariable: 'HARBOR_ROBOT_USER',
                        passwordVariable: 'HARBOR_ROBOT_PASS'
                    )]) {
                        script {
                            COMPONENT_REPO.each { component, repo ->
                                env.CURRENT_REPO = repo
                                sh '''
                                    set -eu
                                    export SSL_CERT_FILE="${HARBOR_CA_PATH}"
                                    IMAGE_REF="${HARBOR_HOST}/${HARBOR_PROJECT}/${CURRENT_REPO}:${CANDIDATE_TAG}"
                                    REPORT_FILE="/tmp/trivy-${CURRENT_REPO}.json"

                                    trivy image \\
                                      --format json \\
                                      --severity CRITICAL,HIGH \\
                                      --exit-code 0 \\
                                      --username "${HARBOR_ROBOT_USER}" \\
                                      --password "${HARBOR_ROBOT_PASS}" \\
                                      --cache-dir /tmp/trivy-cache \\
                                      --output "${REPORT_FILE}" \\
                                      "${IMAGE_REF}"

                                    python3 - "${REPORT_FILE}" "${CURRENT_REPO}" <<'PYEOF'
import sys, json

report_file, repo = sys.argv[1], sys.argv[2]

with open(report_file) as f:
    data = json.load(f)

vulns = []
for result in (data.get("Results") or []):
    vulns.extend(result.get("Vulnerabilities") or [])

critical = [v for v in vulns if str(v.get("Severity", "")).upper() == "CRITICAL"]
high_fixable = [
    v for v in vulns
    if str(v.get("Severity", "")).upper() == "HIGH" and v.get("FixedVersion")
]

print(f"[{repo}] CRITICAL={len(critical)}, HIGH(fix 있음)={len(high_fixable)}, 전체={len(vulns)}")

if critical or high_fixable:
    for v in (critical + high_fixable):
        print(f"  - {v.get('VulnerabilityID')} severity={v.get('Severity')} pkg={v.get('PkgName')} fixed={v.get('FixedVersion')}")
    print(f"[{repo}] Scan 차단 정책 위반 - Promote 진행 불가")
    sys.exit(1)

print(f"[{repo}] Scan 통과")
PYEOF
                                '''
                            }
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // Promote: 컴포넌트별 Candidate 태그가 가리키는 아티팩트에 최종
        // 태그(git-*)를 추가한다 (재빌드/재푸시 없음).
        // --------------------------------------------------------------
        stage('Promote') {
            steps {
                container('python') {
                    withCredentials([usernamePassword(
                        credentialsId: env.HARBOR_API_CRED,
                        usernameVariable: 'HARBOR_API_USER',
                        passwordVariable: 'HARBOR_API_PASS'
                    )]) {
                        script {
                            COMPONENT_REPO.each { component, repo ->
                                env.CURRENT_REPO = repo
                                sh '''
                                    python3 - <<'PYEOF'
import os, json, urllib.request, urllib.error, base64

host  = os.environ["HARBOR_HOST"]
proj  = os.environ["HARBOR_PROJECT"]
repo  = os.environ["CURRENT_REPO"]
cand  = os.environ["CANDIDATE_TAG"]
final = os.environ["FINAL_TAG"]
user  = os.environ["HARBOR_API_USER"]
pw    = os.environ["HARBOR_API_PASS"]

url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{cand}/tags"
body = json.dumps({"name": final}).encode()

req = urllib.request.Request(url, data=body, method="POST")
auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
req.add_header("Authorization", f"Basic {auth}")
req.add_header("Content-Type", "application/json")

try:
    with urllib.request.urlopen(req, timeout=15, cafile=os.environ["HARBOR_CA_PATH"]) as resp:
        print(f"Promote OK [{repo}]: {resp.status}")
except urllib.error.HTTPError as e:
    print(f"Promote FAILED [{repo}]: {e.code} {e.read().decode()}")
    raise SystemExit(1)
PYEOF
                                '''
                            }
                        }
                    }
                }
            }
        }

        // --------------------------------------------------------------
        // Digest 일치 검증 + PASS 경로 Candidate 태그만 삭제.
        //
        // [수정, 팀 리뷰 반영] 기존에는 DELETE /artifacts/{cand} 를 호출해
        // digest(Artifact) 자체를 지웠음. Promote 이후 Candidate/Final은
        // 같은 digest를 가리키므로 이 호출은 방금 만든 git-* Final Tag의
        // Artifact까지 함께 지울 수 있는 심각한 버그였음.
        // Harbor의 Tag 전용 삭제 엔드포인트
        //   DELETE /artifacts/{reference}/tags/{tag_name}
        // 로 교체 — reference는 살아남는 final 태그를 사용하고(같은
        // Artifact를 가리키므로 조회 가능), tag_name에 candidate 태그만
        // 지정해 scan-* 태그만 제거하고 Artifact/Final Tag는 그대로 둔다.
        // --------------------------------------------------------------
        stage('Verify Digest & Cleanup Candidate') {
            steps {
                container('python') {
                    withCredentials([usernamePassword(
                        credentialsId: env.HARBOR_API_CRED,
                        usernameVariable: 'HARBOR_API_USER',
                        passwordVariable: 'HARBOR_API_PASS'
                    )]) {
                        script {
                            COMPONENT_REPO.each { component, repo ->
                                env.CURRENT_REPO = repo
                                sh '''
                                    python3 - <<'PYEOF'
import os, json, urllib.request, urllib.error, base64

host  = os.environ["HARBOR_HOST"]
proj  = os.environ["HARBOR_PROJECT"]
repo  = os.environ["CURRENT_REPO"]
cand  = os.environ["CANDIDATE_TAG"]
final = os.environ["FINAL_TAG"]
user  = os.environ["HARBOR_API_USER"]
pw    = os.environ["HARBOR_API_PASS"]
cafile = os.environ["HARBOR_CA_PATH"]

def get_digest(tag):
    url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{tag}"
    req = urllib.request.Request(url)
    auth = base64.b64encode(f"{user}:{pw}".encode()).decode()
    req.add_header("Authorization", f"Basic {auth}")
    with urllib.request.urlopen(req, timeout=15, cafile=cafile) as resp:
        return json.loads(resp.read())["digest"]

try:
    cand_digest  = get_digest(cand)
    final_digest = get_digest(final)
except Exception as e:
    print(f"[{repo}] Digest 조회 실패: {e}")
    raise SystemExit(1)

if cand_digest != final_digest:
    print(f"[{repo}] DIGEST MISMATCH: candidate={cand_digest} final={final_digest}")
    raise SystemExit(1)

print(f"[{repo}] Digest 일치 확인: {final_digest}")

# Tag 전용 삭제: reference=final 태그(살아남는 태그, 같은 Artifact),
# tag_name=candidate 태그. Artifact 자체는 건드리지 않는다.
del_url = f"https://{host}/api/v2.0/projects/{proj}/repositories/{repo}/artifacts/{final}/tags/{cand}"
